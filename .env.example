# Passwords are per card, and optional. A card with neither variable set is
# link-only: anyone with the URL can open it.
#
# Shared fallback, applied to every card that has no password of its own.
CARD_PASSWORD=
#
# Per-card override: CARD_PASSWORD_<SLUG>, slug upper-cased with every
# non-alphanumeric character replaced by an underscore. For example:
#   /c/2026-newyear-7k2m  ->  CARD_PASSWORD_2026_NEWYEAR_7K2M
#   /c/thanks-sample-3f9q ->  CARD_PASSWORD_THANKS_SAMPLE_3F9Q
