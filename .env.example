# Passwords are per card, and optional. A card with none of these set is
# link-only: anyone with the URL can open it.
#
# Precedence (spec v0.2 §14.9), first match wins:
#   CARD_PASSWORD_<SLUG>        this file
#   access.passwordHash         config/cards.config.ts, issued by the editor
#   CARD_PASSWORD               this file
#   none                        link-only
#
# An environment password always wins, so a card set up under v0.1 keeps
# behaving exactly as it did.

# Shared fallback, applied to every card that has no password of its own.
CARD_PASSWORD=
#
# Per-card override: CARD_PASSWORD_<SLUG>, slug upper-cased with every
# non-alphanumeric character replaced by an underscore. For example:
#   /c/2026-newyear-7k2m  ->  CARD_PASSWORD_2026_NEWYEAR_7K2M
#   /c/thanks-sample-3f9q ->  CARD_PASSWORD_THANKS_SAMPLE_3F9Q

# Signs the access cookie for cards whose password is a hash in the config.
# Required as soon as any card has an access.passwordHash: without it, those
# cards stay shut (fail closed) and a production build refuses to start.
# Any long random string will do — `openssl rand -base64 32`.
ACCESS_SECRET=

# ---------------------------------------------------------------------------
# Email (spec v0.2 §14.7). Everything the receiver writes goes to the sender by
# email; KARTA_SPACE stores none of it. With these unset, the reply rocket and
# the receiver's comet are simply not offered — the card works without them.
# ---------------------------------------------------------------------------

# Where links in emails point. No trailing slash needed.
PUBLIC_BASE_URL=

# Resend. The reply and comet features need all three of these together.
RESEND_API_KEY=
MAIL_FROM="KARTA_SPACE <cards@yourdomain>"
NOTIFY_TO=

# Development only: deliver to ./.mail/ instead of to Resend, so the rocket's
# flight and the comet's boarding can be tested with no account at all. The
# routes, the gating, the templates, the rate limit and the sealed token all
# run as normal — only the last hop writes a file. Ignored in production.
#   MAIL_DEV_SINK=1
#
# Optional per-card inbox: CARD_NOTIFY_TO_<SLUG>, slug upper-cased with every
# non-alphanumeric character replaced by an underscore.
#   CARD_NOTIFY_TO_2026_NEWYEAR_7K2M=someone-else@example.com

# Seals a receiver's comet, so its message cannot be read before its date.
# 32 random bytes, base64 — `openssl rand -base64 32`.
#
# Rotating this loses every comet that is still on its way: the messages are
# inside the links, not in a database, and a new key cannot open old ones.
COMET_SECRET=

# Protects the daily satellite-reminder route. Any random string of 16+ chars.
CRON_SECRET=
